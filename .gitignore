node_modules/
__pycache__/
*.pyc
.DS_Store

# Preview renders are regenerable QA output -- `--render` rewrites them, and the
# full set is ~15 MB.  A small curated showcase is force-added under docs/shots/.
docs/qa/

# scratch
/tmp/
*.blend1

# vendored source meshes (~40 MB); char_build.py consumes them, the built
# characters in public/assets are what the runtime ships
assets/source/

# three.js is symlinked in from node_modules by `npm run serve`
public/vendor/

# ad-hoc probes; the durable ones live in tools/shots.mjs and tools/smoke.mjs
tools/scratch/
docs/shots/_*

# One-off browser probes. A throwaway playwright script has to sit in the repo
# root because ESM resolves `playwright` from ./node_modules and NODE_PATH does
# not apply to ESM -- so it cannot live in a scratch directory the way the
# python ones do. Named `_*.mjs` and ignored rather than left to dirty the tree
# on every run.
/_*.mjs
.claude/scheduled_tasks.lock
